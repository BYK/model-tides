{
  "name": "model-tides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Weekly model usage charts with a local CLI for private history and sharing.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "deploy": "cf deploy",
    "contribute": "node --experimental-strip-types scripts/contribute.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "brotli-wasm": "^3.0.1",
    "lucide": "^1.52.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@types/node": "20.19.43",
    "cf": "1.0.0-beta.10",
    "fossilize": "0.11.0",
    "typescript": "5.8.3",
    "vite": "8.3.1"
  }
}
